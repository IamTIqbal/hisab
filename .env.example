# Copy to .env.local for local use. On Vercel, set these in Project → Settings →
# Environment Variables. Details: docs/DEPLOY.md

# Database. Local file for development; libsql://… plus a token for Turso.
TURSO_DATABASE_URL=file:./storage/hisab.sqlite
TURSO_AUTH_TOKEN=

# Required in production: openssl rand -hex 32
SESSION_SECRET=

# Asked for on /setup so nobody else can claim a fresh deploy: openssl rand -hex 16
SETUP_TOKEN=

# Public address, used in emailed sign-in links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional email. Leave SMTP_HOST empty to sign in by password only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
